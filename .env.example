# Database
DATABASE_URL="postgresql://postgres:password@host:5432/dbname"
# DIRECT_URL: for migrations when DATABASE_URL goes through a pooler (e.g. Supabase).
# Same as DATABASE_URL when connecting directly.
DIRECT_URL="postgresql://postgres:password@host:5432/dbname"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Owner account (used by seed + Google allowlist)
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD=""

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ── Supabase Storage (screenshots) — server-side only ──
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>  (secret — never expose client-side)"
# When unset, uploads fall back to local disk at ./storage/uploads (dev only).
